# Storage
# STORAGE_PATH is optional when STORAGE_BACKEND=s3
STORAGE_BACKEND=filesystem
NEXT_PUBLIC_STORAGE_BACKEND=filesystem
STORAGE_PATH=./storage

# S3 storage enables video uploads by default. Video requires the CDK-provisioned
# MediaConvert role and CloudFront distribution. AWS_MEDIACONVERT_ROLE_ARN is
# optional when using the CDK default role name. Set both video flags to false for
# an image-only S3 deployment.
# STORAGE_BACKEND=s3
# NEXT_PUBLIC_STORAGE_BACKEND=s3
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-photo-bucket
# AWS_CLOUDFRONT_DOMAIN=d1234.cloudfront.net
# NEXT_PUBLIC_CLOUDFRONT_DOMAIN=d1234.cloudfront.net
# AWS_MEDIACONVERT_ROLE_ARN=arn:aws:iam::123456789012:role/PhotoProfileMediaConvertRole
# VIDEO_ENABLED=false
# NEXT_PUBLIC_VIDEO_ENABLED=false

# Queue Backend (SQS-only for Vercel/Lambda)
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/photo-profile-queue

# Upstash Redis (Optional - for rate limiting; degrades gracefully if not set)
# UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Authentication
# Secret key for JWT signing - must be at least 32 characters
AUTH_SECRET=your-secret-key-at-least-32-characters-long
# Bcrypt hash of admin password - generate with: npx tsx scripts/hash-password.ts <password>
ADMIN_PASSWORD_HASH=generate-with-scripts/hash-password.ts

# Security
# Trusted proxy IP addresses (comma-separated) - only trust x-forwarded-for from these IPs
# Example: TRUSTED_PROXIES=127.0.0.1,10.0.0.1
# Leave empty if not behind a reverse proxy
# TRUSTED_PROXIES=

# Site URL (used for OpenGraph meta tags - absolute URLs required)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Social Links (optional — displayed in footer)
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/yourhandle
# NEXT_PUBLIC_SOCIAL_GITHUB=https://github.com/yourhandle
# NEXT_PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com/in/yourhandle
